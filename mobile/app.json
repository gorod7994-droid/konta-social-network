{
  "expo": {
    "name": "KONTA",
    "slug": "konta-ios",
    "scheme": "konta",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ua.pp.konta.app"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "KONTA потрібен доступ до фотографій для аватарів, історій і дописів."
        }
      ]
    ]
  }
}
